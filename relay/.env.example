# Copiá este archivo a .env si querés cambiar la config local (opcional,
# todos tienen default). En Render, estas mismas variables se configuran
# en el dashboard del servicio (o via render.yaml, ya incluido).

SYMBOL=btcusdt
BUCKET_SIZE=5
# 500 buckets * $5 = $2500 para cada lado del precio ancla = $5000 de rango total visible.
# Si queres MAS rango todavia, subilo -- pero ojo que cada bucket extra es
# mas trabajo de render (mas instancias por fila, x200 filas de historial).
RANGO_BUCKETS=500
INTERVALO_ENVIO_MS=250
PORT=8081

# Cada cuanto se recalcula el gamma exposure (Deribit, opciones de BTC).
GEX_INTERVALO_MS=60000

# El precio oscila LIBRE dentro de la ventana visible -- la ventana no se
# mueve en cada tick. Solo se re-centra cuando el precio en vivo llega a
# estar a menos de este margen (en USD) del borde. Con RANGO_BUCKETS=500 y
# BUCKET_SIZE=5 el medio-rango es $2500, asi que con 700 de margen el
# precio puede moverse libremente unos $1800 desde el centro antes de que
# la ventana empiece a seguirlo (antes, con el rango de $2200, eran $400).
MARGEN_RECENTRADO_USD=700

# Cuanto se mueve el ancla (en USD) por cada click de las flechas ↑/↓ de pan
# manual en el frontend. Mientras el pan manual esta activo, el auto-
# recentrado de arriba queda en pausa (se retoma con el boton "en vivo").
PASO_PAN_USD=150

# Poné MODO_DEMO=1 para probar sin conectarte a Binance (datos sinteticos).
MODO_DEMO=0
